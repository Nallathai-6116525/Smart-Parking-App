import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.HashMap;
import java.util.regex.Pattern;
import java.time.LocalDateTime;
import java.time.Duration;

public class SmartParkingApp {
    private static final int TOTAL_SLOTS = 25;
    private static final HashMap<Integer, String> slots = new HashMap<>();
    private static final HashMap<String, String> userMap = new HashMap<>();
    private static final HashMap<String, String> vehicleTypeMap = new HashMap<>();
    private static final HashMap<String, LocalDateTime> checkInMap = new HashMap<>();
    private static final HashMap<String, String> passwordMap = new HashMap<>();
    private static final Pattern VEHICLE_PATTERN = Pattern.compile("^[A-Z]{2}[0-9]{2}[A-Z]{1,2}[0-9]{4}$");

    private static final Color primary = new Color(33, 150, 243);
    private static final Color success = new Color(76, 175, 80);
    private static final Color danger = new Color(244, 67, 54);
    private static final Color bg = new Color(250, 250, 250);
    private static final Color hover = new Color(100, 181, 246);

    public static void main(String[] args) {
        passwordMap.put("ADMIN", "admin123"); // Admin credentials
        SwingUtilities.invokeLater(SmartParkingApp::showLogin);
    }

    private static void showLogin() {
        JFrame frame = new JFrame("Smart Parking Login");
        frame.setExtendedState(JFrame.MAXIMIZED_BOTH);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.getContentPane().setBackground(bg);
        frame.setLayout(new GridBagLayout());

        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(20, 20, 20, 20);

        JLabel title = new JLabel("Smart Parking System");
        title.setFont(new Font("Segoe UI", Font.BOLD, 36));
        title.setForeground(primary);
        gbc.gridx = 0; gbc.gridy = 0; gbc.gridwidth = 2;
        frame.add(title, gbc);

        gbc.gridwidth = 1;
        gbc.gridx = 0; gbc.gridy = 1;
        frame.add(new JLabel("Vehicle Number:"), gbc);
        JTextField vehicleField = new JTextField(20);
        gbc.gridx = 1;
        frame.add(vehicleField, gbc);

        gbc.gridx = 0; gbc.gridy = 2;
        frame.add(new JLabel("Name:"), gbc);
        JTextField nameField = new JTextField(20);
        gbc.gridx = 1;
        frame.add(nameField, gbc);

        gbc.gridx = 0; gbc.gridy = 3;
        frame.add(new JLabel("Password:"), gbc);
        JPasswordField passField = new JPasswordField(20);
        gbc.gridx = 1;
        frame.add(passField, gbc);

        JButton loginBtn = new JButton("Login");
        styleButton(loginBtn, primary);
        gbc.gridx = 0; gbc.gridy = 4; gbc.gridwidth = 2;
        frame.add(loginBtn, gbc);

        JLabel msg = new JLabel("", SwingConstants.CENTER);
        msg.setForeground(danger);
        gbc.gridy = 5;
        frame.add(msg, gbc);

        loginBtn.addActionListener(e -> {
            String vehicle = vehicleField.getText().trim().toUpperCase();
            String name = nameField.getText().trim();
            String pass = new String(passField.getPassword()).trim();

            if (vehicle.equals("ADMIN") && name.equalsIgnoreCase("Admin") && pass.equals(passwordMap.get("ADMIN"))) {
                frame.dispose();
                showAdminDashboard();
            } else if (VEHICLE_PATTERN.matcher(vehicle).matches() && !name.isEmpty() && !pass.isEmpty()) {
                passwordMap.put(vehicle, pass);
                userMap.put(vehicle, name);
                frame.dispose();
                showUserDashboard(vehicle);
            } else {
                msg.setText("Invalid login details.");
            }
        });

        frame.setVisible(true);
    }

    private static void showAdminDashboard() {
        JFrame frame = new JFrame("Admin Dashboard");
        frame.setExtendedState(JFrame.MAXIMIZED_BOTH);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setLayout(new BorderLayout(20, 20));
        frame.getContentPane().setBackground(bg);

        JLabel header = new JLabel("Admin View: All Parking Slots", SwingConstants.CENTER);
        header.setFont(new Font("Segoe UI", Font.BOLD, 28));
        header.setForeground(primary);
        frame.add(header, BorderLayout.NORTH);

        JPanel slotPanel = new JPanel(new GridLayout(5, 5, 20, 20));
        slotPanel.setBackground(bg);
        refreshSlots(slotPanel);
        frame.add(slotPanel, BorderLayout.CENTER);

        JPanel bottom = new JPanel();
        bottom.setBackground(bg);
        JButton resetBtn = new JButton("Reset Lot");
        JButton logoutBtn = new JButton("Logout");
        styleButton(resetBtn, danger);
        styleButton(logoutBtn, Color.GRAY);
        bottom.add(resetBtn);
        bottom.add(logoutBtn);
        frame.add(bottom, BorderLayout.SOUTH);

        resetBtn.addActionListener(e -> {
            slots.clear();
            userMap.clear();
            vehicleTypeMap.clear();
            checkInMap.clear();
            refreshSlots(slotPanel);
        });

        logoutBtn.addActionListener(e -> {
            frame.dispose();
            showLogin();
        });

        frame.setVisible(true);
    }

    private static void showUserDashboard(String vehicle) {
        JFrame frame = new JFrame("User Dashboard");
        frame.setExtendedState(JFrame.MAXIMIZED_BOTH);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setLayout(new BorderLayout(20, 20));
        frame.getContentPane().setBackground(bg);

        String name = userMap.get(vehicle);
        JLabel header = new JLabel("Welcome, " + name + " (" + vehicle + ")", SwingConstants.CENTER);
        header.setFont(new Font("Segoe UI", Font.BOLD, 28));
        header.setForeground(primary);
        frame.add(header, BorderLayout.NORTH);

        JPanel center = new JPanel(new GridLayout(3, 1, 20, 20));
        center.setBackground(bg);

        JButton bookBtn = new JButton("Select Slot");
        JButton viewBtn = new JButton("View My Slot");
        JButton checkoutBtn = new JButton("Checkout");
        styleButton(bookBtn, success);
        styleButton(viewBtn, primary);
        styleButton(checkoutBtn, danger);
        center.add(bookBtn);
        center.add(viewBtn);
        center.add(checkoutBtn);
        frame.add(center, BorderLayout.CENTER);

        JButton logoutBtn = new JButton("Logout");
        styleButton(logoutBtn, Color.GRAY);
        JPanel bottom = new JPanel();
        bottom.setBackground(bg);
        bottom.add(logoutBtn);
        frame.add(bottom, BorderLayout.SOUTH);

        bookBtn.addActionListener(e -> showSlotSelection(vehicle));
        viewBtn.addActionListener(e -> viewSlot(frame, vehicle));
        checkoutBtn.addActionListener(e -> checkoutSlot(frame, vehicle));
        logoutBtn.addActionListener(e -> {
            frame.dispose();
            showLogin();
        });

        frame.setVisible(true);
    }

    // Slot selection, viewSlot, checkoutSlot, refreshSlots, styleButton methods go here...
private static void showSlotSelection(String vehicle) {
    JFrame frame = new JFrame("Select a Slot");
    frame.setExtendedState(JFrame.MAXIMIZED_BOTH);
    frame.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
    frame.setLayout(new BorderLayout(20, 20));
    frame.getContentPane().setBackground(bg);

    JLabel header = new JLabel("Click an available slot to book", SwingConstants.CENTER);
    header.setFont(new Font("Segoe UI", Font.BOLD, 28));
    header.setForeground(primary);
    frame.add(header, BorderLayout.NORTH);

    JPanel grid = new JPanel(new GridLayout(5, 5, 20, 20));
    grid.setBackground(bg);

    for (int i = 1; i <= TOTAL_SLOTS; i++) {
        JButton slotBtn = new JButton("Slot " + i);
        slotBtn.setFont(new Font("Segoe UI", Font.BOLD, 16));
        slotBtn.setPreferredSize(new Dimension(150, 100));

        if (slots.containsKey(i)) {
            slotBtn.setText("<html>Slot " + i + "<br>Booked</html>");
            slotBtn.setBackground(danger);
            slotBtn.setForeground(Color.WHITE);
            slotBtn.setEnabled(false);
        } else {
            slotBtn.setBackground(success);
            slotBtn.setForeground(Color.BLACK);
            int slotNum = i;
            slotBtn.addActionListener(e -> {
                String[] options = {"Car", "Bike"};
                String type = (String) JOptionPane.showInputDialog(frame, "Select vehicle type:", "Vehicle Type",
                        JOptionPane.QUESTION_MESSAGE, null, options, options[0]);
                if (type == null) return;

                slots.put(slotNum, vehicle);
                vehicleTypeMap.put(vehicle, type);
                checkInMap.put(vehicle, LocalDateTime.now());

                JOptionPane.showMessageDialog(frame, "Slot " + slotNum + " booked for " + userMap.get(vehicle) + " (" + type + ")");
                frame.dispose();
                showUserDashboard(vehicle);
            });
        }

        grid.add(slotBtn);
    }

    frame.add(grid, BorderLayout.CENTER);

    JButton backBtn = new JButton("Back to Dashboard");
    styleButton(backBtn, Color.GRAY);
    backBtn.addActionListener(e -> {
        frame.dispose();
        showUserDashboard(vehicle);
    });

    JPanel bottom = new JPanel();
    bottom.setBackground(bg);
    bottom.add(backBtn);
    frame.add(bottom, BorderLayout.SOUTH);

    frame.setVisible(true);
}

private static void viewSlot(JFrame frame, String vehicle) {
    for (int i = 1; i <= TOTAL_SLOTS; i++) {
        if (vehicle.equals(slots.get(i))) {
            String name = userMap.get(vehicle);
            String type = vehicleTypeMap.getOrDefault(vehicle, "Car");
            LocalDateTime checkIn = checkInMap.get(vehicle);
            LocalDateTime now = LocalDateTime.now();
            Duration duration = Duration.between(checkIn, now);
            long hours = Math.max(1, duration.toHours());
            long rate = type.equals("Bike") ? 50 : 150;
            long amount = hours * rate;

            String message = "Slot " + i + " booked for " + name +
                    "\nVehicle: " + vehicle +
                    "\nType: " + type +
                    "\nCheck-in: " + checkIn +
                    "\nNow: " + now +
                    "\nDuration: " + hours + " hour(s)" +
                    "\nRate: ₹" + rate + "/hour" +
                    "\nAmount Due: ₹" + amount;

            JOptionPane.showMessageDialog(frame, message);
            return;
        }
    }
    JOptionPane.showMessageDialog(frame, "No slot found for this vehicle.");
}

private static void checkoutSlot(JFrame frame, String vehicle) {
    for (int i = 1; i <= TOTAL_SLOTS; i++) {
        if (vehicle.equals(slots.get(i))) {
            String name = userMap.get(vehicle);
            String type = vehicleTypeMap.getOrDefault(vehicle, "Car");
            LocalDateTime checkIn = checkInMap.get(vehicle);
            LocalDateTime checkoutTime = LocalDateTime.now();
            Duration duration = Duration.between(checkIn, checkoutTime);
            long hours = Math.max(1, duration.toHours());
            long rate = type.equals("Bike") ? 50 : 150;
            long amount = hours * rate;

            String message = "Checkout Summary:\n" +
                    "Name: " + name +
                    "\nVehicle: " + vehicle +
                    "\nType: " + type +
                    "\nSlot: " + i +
                    "\nCheck-in: " + checkIn +
                    "\nCheckout: " + checkoutTime +
                    "\nDuration: " + hours + " hour(s)" +
                    "\nRate: ₹" + rate + "/hour" +
                    "\nAmount Due: ₹" + amount;

            JOptionPane.showMessageDialog(frame, message);

            slots.remove(i);
            vehicleTypeMap.remove(vehicle);
            checkInMap.remove(vehicle);
            return;
        }
    }
    JOptionPane.showMessageDialog(frame, "Vehicle not found in any slot.");
}

private static void refreshSlots(JPanel panel) {
    panel.removeAll();
    for (int i = 1; i <= TOTAL_SLOTS; i++) {
        JButton slot = new JButton();
        slot.setPreferredSize(new Dimension(150, 100));
        slot.setFont(new Font("Segoe UI", Font.BOLD, 16));
        if (slots.containsKey(i)) {
            String vehicle = slots.get(i);
            String name = userMap.getOrDefault(vehicle, "Unknown");
            String type = vehicleTypeMap.getOrDefault(vehicle, "Car");
            slot.setText("<html>Slot " + i + "<br>" + name + "<br>" + vehicle + "<br>" + type + "</html>");
            slot.setBackground(danger);
            slot.setForeground(Color.WHITE);
        } else {
            slot.setText("<html>Slot " + i + "<br>[Empty]</html>");
            slot.setBackground(success);
            slot.setForeground(Color.BLACK);
        }
        slot.setEnabled(false);
        panel.add(slot);
    }
    panel.revalidate();
    panel.repaint();
}

private static void styleButton(JButton button, Color base) {
    button.setBackground(base);
    button.setForeground(Color.WHITE);
    button.setFocusPainted(false);
    button.setBorderPainted(false);
    button.setFont(new Font("Segoe UI", Font.BOLD, 18));
    button.setPreferredSize(new Dimension(160, 40));

    button.addMouseListener(new MouseAdapter() {
        public void mouseEntered(MouseEvent e) {
            button.setBackground(hover);
        }

        public void mouseExited(MouseEvent e) {
            button.setBackground(base);
        }
    });
}
}
